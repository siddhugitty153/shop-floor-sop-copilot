EMBEDDING_MODEL=tfidf-vectorizer
SIMILARITY_THRESHOLD=0.085
TOP_K=4

# LLM Providers: gemini, lmstudio, ollama, groq, extractive
LLM_PROVIDER=gemini

# Google Gemini API (Recommended & fast)
GEMINI_API_KEY=

# LM Studio Local LLM (OpenAI-compatible server at port 1234)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Groq Hosted API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
